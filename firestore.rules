rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string
        && data.email is string
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('role' in data) || (data.role is string && (data.role == 'USER' || data.role == 'ADMIN' || data.role == 'SUPPORT' || data.role == 'OWNER')));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      
      // Prevent self-assigned elevated role on registration
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == 'USER');

      // Prevent role modification from client SDK
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);

      allow delete: if false;
    }

    // Entitlements: user can read their own entitlements, client cannot write/create/delete
    match /entitlements/{entitlementId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Orders: user can read their own orders, cannot approve or modify status
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'CREATED';
      allow update, delete: if false;
    }
  }
}
