{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && rm -rf build && cp -r dist build",
    "preview": "vite preview",
    "start": "node server.ts",
    "clean": "rm -rf dist build server.js",
    "lint": "tsc --noEmit",
    "evo:regression": "node scripts/evo-structural-regression.mjs && node scripts/evo-magazine-regression.mjs",
    "admin:create-owner": "node scripts/admin/create-owner.mjs",
    "evo:observability": "node --import tsx --test scripts/evo-observability.test.ts",
    "evo:observability:browser": "node scripts/evo-observability-browser.mjs",
    "evo:magazine:check": "node scripts/evo-magazine-regression.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
